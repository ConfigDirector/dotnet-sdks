<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ConfigDirector.Samples.OpenFeature.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- Nothing from ConfigDirector: the tests swap the provider for the in-memory one the
       OpenFeature SDK ships, which arrives transitively through the sample. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
    <ProjectReference Include="../ConfigDirector.Samples.OpenFeature/ConfigDirector.Samples.OpenFeature.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>

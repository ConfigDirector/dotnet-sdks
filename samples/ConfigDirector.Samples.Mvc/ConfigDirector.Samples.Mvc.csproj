<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ConfigDirector.Samples.Mvc</RootNamespace>
    <UserSecretsId>configdirector-mvc-sample</UserSecretsId>
  </PropertyGroup>

  <!-- Only the ASP.NET Core package either way: the server SDK arrives transitively, which is
       how a consuming application gets both from one install. -->
  <ItemGroup Condition="'$(UseLocalSdk)' == 'true'">
    <ProjectReference Include="../../src/ConfigDirector.ServerSdk.AspNetCore/ConfigDirector.ServerSdk.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalSdk)' != 'true'">
    <PackageReference Include="ConfigDirector.ServerSdk.AspNetCore" />
  </ItemGroup>

</Project>

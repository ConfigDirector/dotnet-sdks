<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ConfigDirector.Samples.OpenFeature</RootNamespace>
    <UserSecretsId>configdirector-openfeature-sample</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenFeature.Hosting" />
  </ItemGroup>

  <!-- Only the provider either way: the server SDK and the OpenFeature SDK arrive transitively,
       which is how a consuming application gets all three from one install. -->
  <ItemGroup Condition="'$(UseLocalSdk)' == 'true'">
    <ProjectReference Include="../../src/ConfigDirector.OpenFeature.ServerProvider/ConfigDirector.OpenFeature.ServerProvider.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalSdk)' != 'true'">
    <PackageReference Include="ConfigDirector.OpenFeature.ServerProvider" />
  </ItemGroup>

</Project>

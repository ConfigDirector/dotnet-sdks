# Copy to .env and fill in. .env is gitignored; never commit real keys.
#
#   cd samples/ConfigDirector.Samples.AspNetCore && cp .env.example .env
#
# These are ordinary environment variables, in the form ASP.NET Core already understands: "__"
# separates configuration sections. Anything here can equally be exported by a deployment
# platform, and an exported variable wins over this file.

# Your ConfigDirector server SDK key. A secret.
ConfigDirector__ServerSdkKey=fake-sample-key

# Only needed when routing through a proxy to reach ConfigDirector.
# ConfigDirector__Url=https://proxy.internal/configdirector

# Streaming, Polling, or OneTime.
ConfigDirector__Mode=Streaming

# Initialization timeout, as HH:MM:SS.
ConfigDirector__Timeout=00:00:03

# Set to Debug to watch every evaluation as it happens.
Logging__LogLevel__ConfigDirector=Information

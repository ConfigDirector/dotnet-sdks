<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!-- VersionPrefix belongs to each package, since each is tagged and released on its own; a new
       package that leaves it unset silently builds as 1.0.0. The release workflow overrides it
       with the version from the tag it builds. -->
  <PropertyGroup>
    <VersionSuffix Condition="'$(VersionSuffix)' == '' And '$(CI)' != 'true'">dev</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup>
    <Company>ConfigDirector</Company>
    <Authors>ConfigDirector</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ConfigDirector/dotnet-sdks</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ConfigDirector/dotnet-sdks</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>configdirector;feature-flags;feature-toggles;remote-config;configuration</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <!-- A stack trace from a consumer's process should land on the line that threw. SourceLink ships
       in the SDK, so the repository URL and an embedded symbol package are all it needs. -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" Condition="Exists('README.md')" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>

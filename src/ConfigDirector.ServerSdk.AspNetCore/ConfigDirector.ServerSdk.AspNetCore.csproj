<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Overrides the repository default. A hosting package has no netstandard2.0 story, and
         IHostedLifecycleService, which is how initialization runs before Kestrel listens, is net8.0
         onwards. -->
    <TargetFrameworks>net8.0</TargetFrameworks>
    <RootNamespace>ConfigDirector</RootNamespace>
    <!-- The version this package releases at. The release workflow checks the tag against it. -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <Description>ASP.NET Core integration for the ConfigDirector server SDK: dependency injection, configuration binding and startup initialization.</Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- The configuration binding happens in this assembly rather than in the consuming application,
       so the source-generated binder has to be switched on here for a trimmed consumer to stay
       free of the reflective binder's warnings. -->
  <PropertyGroup>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- The packed dependency on ConfigDirector.ServerSdk takes that project's own version, so
         this package always declares the version it was built against. That is why the release
         workflow checks the tag against the version in the project rather than passing one in:
         a -p:Version override flows across this reference and would record the wrong dependency. -->
    <ProjectReference Include="../ConfigDirector.ServerSdk/ConfigDirector.ServerSdk.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ConfigDirector</RootNamespace>
    <Description>Server SDK for ConfigDirector, a remote configuration and feature flag service.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Net.ServerSentEvents" />
  </ItemGroup>

  <!-- In-box from net8.0 onwards; only netstandard2.0 needs the packages. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ConfigDirector.ServerSdk.Tests" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ConfigDirector</RootNamespace>
    <!-- The version this package releases at. The release workflow checks the tag against it. -->
    <VersionPrefix>1.2.0</VersionPrefix>
    <Description>Server SDK for ConfigDirector, a remote configuration and feature flag service.</Description>
  </PropertyGroup>

  <!-- netstandard2.0 has no trimming or AOT story, and the analyzers do not run there. -->
  <PropertyGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Net.ServerSentEvents" />
  </ItemGroup>

  <!-- In-box from net8.0 onwards; only netstandard2.0 needs the packages. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ConfigDirector.ServerSdk.Tests" />
    <InternalsVisibleTo Include="ConfigDirector.ServerSdk.SlowTests" />
  </ItemGroup>

</Project>

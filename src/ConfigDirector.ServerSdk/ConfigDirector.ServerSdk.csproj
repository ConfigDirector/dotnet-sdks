<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="Version.props" />

  <PropertyGroup>
    <RootNamespace>ConfigDirector</RootNamespace>
    <Description>Server SDK for ConfigDirector, a remote configuration and feature flag service.</Description>
  </PropertyGroup>

  <!-- netstandard2.0 has no trimming or AOT story, and the analyzers do not run there. -->
  <PropertyGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Net.ServerSentEvents" />
  </ItemGroup>

  <!-- In-box from net8.0 onwards; only netstandard2.0 needs the packages. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ConfigDirector.ServerSdk.Tests" />
    <InternalsVisibleTo Include="ConfigDirector.ServerSdk.SlowTests" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ConfigDirector.OpenFeature.ServerProvider" />
  </ItemGroup>

  <!-- The testing package builds a client over the internal in-memory connection. It is released
       with the SDK at the same version and checks that at runtime, since a consumer's NuGet graph
       can resolve a newer SDK than the one it was built against. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ConfigDirector.ServerSdk.Testing" />
  </ItemGroup>

</Project>
